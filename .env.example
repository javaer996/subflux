# 复制为 .env 后按需修改：cp .env.example .env

# 面板对外端口
SUBFLUX_PORT=8888

# 代码来源：可换成自己的 fork 或私有仓库（https + token，或 ssh 需要额外挂载密钥）
REPO_URL=https://github.com/javaer996/subflux.git
GIT_REF=main

# Mihomo 版本；MIHOMO_URL 可填完整 .gz 直链（GitHub 被墙时用）
MIHOMO_VERSION=1.19.33
MIHOMO_URL=
# 镜像前缀，例如 https://ghfast.top/https://github.com
MIHOMO_MIRROR=

# 设为 0 则不下载 Mihomo（站点检测与 CN 实际检测不可用）
INSTALL_MIHOMO=1
