# 复制为 .env 后按需修改：cp .env.example .env

# 面板对外端口
SUBFLUX_PORT=8888

# 代码来源：可换成自己的 fork 或私有仓库（https + token，或 ssh 需要额外挂载密钥）
REPO_URL=https://github.com/javaer996/subflux.git
GIT_REF=main

# Mihomo：版本默认 1.19.33（当前最新）
MIHOMO_VERSION=1.19.33

# 下面两项默认留空 —— 服务器能直连 GitHub 就不需要填
# MIHOMO_URL：完整 .gz 直链，填了就完全绕过自动拼接（优先级最高）
MIHOMO_URL=
# MIHOMO_MIRROR：镜像前缀，只有国内机器需要，例如 https://ghfast.top/https://github.com
MIHOMO_MIRROR=

# 设为 0 则不下载 Mihomo（站点检测与 CN 实际检测不可用）
INSTALL_MIHOMO=1

# ---- 登录认证 ----
# 面板登录账号（不填默认 admin / subflux，请务必修改）
SUBFLUX_USERNAME=admin
SUBFLUX_PASSWORD=subflux
# 可选：会话签名密钥（>=16 字符）。留空则自动生成 data/.session-secret
SUBFLUX_SESSION_SECRET=
# 可选：db.json 敏感字段加密密钥（>=16 字符）。留空则自动生成 data/.secret-key
# 一旦设置后不要随意修改，否则旧的加密数据无法解密。
SUBFLUX_SECRET_KEY=
