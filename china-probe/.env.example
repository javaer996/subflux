# 复制为 .env 后按需修改：cp .env.example .env
# 也可以直接在命令行传：PROBE_TOKEN='...' PROBE_BIND='100.x.y.z' docker compose up -d

# 必填，至少 16 位；主服务里要填同一个值
PROBE_TOKEN=

# 监听地址：填国内机器的 Tailscale IP，不要用 0.0.0.0 暴露到公网
PROBE_BIND=0.0.0.0
PROBE_PORT=8899

# 代码来源
REPO_URL=https://github.com/javaer996/subflux.git
GIT_REF=main

# Mihomo：默认按架构下载；GitHub 慢时用镜像或直链
MIHOMO_VERSION=1.19.33
MIHOMO_URL=
MIHOMO_MIRROR=
